# Copy this file to .env.local for local development, and add the same values
# in Netlify > Site configuration > Environment variables. Never commit real values.

# Public URL of the site, used in email links
SITE_URL=https://trimsbyk.co.uk

# Supabase > Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend > API Keys. EMAIL_FROM must use your verified domain.
RESEND_API_KEY=
EMAIL_FROM=Trims by K <bookings@trimsbyk.co.uk>

# Where new booking requests are emailed
ADMIN_EMAIL=

# Admin login. ADMIN_SECRET is any long random string.
ADMIN_PASSWORD=
ADMIN_SECRET=

# Anthropic Console > API Keys (set a monthly spend limit there too)
ANTHROPIC_API_KEY=

# K's base. Kept private: only used for distance maths and sent in confirmation emails.
BASE_POSTCODE=
BASE_ADDRESS=
